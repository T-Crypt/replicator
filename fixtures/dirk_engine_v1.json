    "size": "length 120, dia 70, joint dia 90",
    "position": "array center [0, 1650, 0]; first piston at radius 1250",
    "material": "copper",
    "count": 6
   },
   {
    "name": "HOT_SECTION_CASING",
    "role": "Houses turbine and exhaust gas path under high temperature.",
    "shape": "Cylinder with external cooling fins and rear conical taper.",
    "size": "OD 780, length 750, fin height 18",
    "position": "center [0, 1625, 0]",
    "material": "titanium",
    "count": 1
   },
   {
    "name": "EXHAUST_CONE",
    "role": "Shapes core exhaust and provides a visible reverse-mode glow reference.",
    "shape": "Cone with smoothed tip and three longitudinal cooling slots.",
    "size": "base dia 600, tip dia 100, length 350",
    "position": "center [0, 2125, 0]",
    "material": "emissive glow (orange)",
    "count": 1
   },
   {
    "name": "EXHAUST_NOZZLE",
    "role": "Final core nozzle and structural rear closure.",
    "shape": "Annular cone with faceted external panels and internal flow liner.",
    "size": "front OD 1100, rear OD 720, front ID 700, rear ID 520, length 250",
    "position": "center [0, 2175, 0]",
    "material": "brushed steel",
    "count": 1
   }
  ],
  "callouts": [
   "Engine axis is +Y; intake face is y=0 and exhaust face is y=2300.",
   "Front and rear fans are counter-rotating; rear fan pitch is mirrored relative to front fan.",
   "Reverse thrust path: bypass duct -> reverse vanes -> forward-facing annular flow.",
   "Actuator pistons engage the reverse cowl only in reverse mode; cowl seals in forward mode.",
   "Hot section materials are limited to titanium and steel; ceramic vanes resist reverse-flow heating."
  ]
 }
