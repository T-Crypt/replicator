 "blueprint": {
  "title": "Vortex-Back Reverse-Thrust Engine",
  "summary": "A non-conventional turbofan with exposed counter-rotating fans and a faceted rear reverse-thrust ring. Its reverse mode uses radial actuators and ceramic vanes to redirect bypass flow forward through an annular duct.",
  "style": "non-conventional exposed-turbine brutalist",
  "dimensions": [
   1350,
   2300,
   1350
  ],
  "parts": [
   {
    "name": "INTAKE_LIP",
    "role": "Defines the engine inlet and splits outer bypass flow from core flow.",
    "shape": "Revolved 2D profile: annular lip with rounded outer edge and chamfered inner edge.",
    "size": "OD 1350, ID 1150, axial depth 80",
    "position": "center [0, 40, 0]",
    "material": "painted (matte graphite)",
    "count": 1
   },
   {
    "name": "INLET_GUIDE_VANE",
    "role": "Pre-swirls air entering the front fan and protects the intake face.",
    "shape": "Extruded airfoil profile, thin flat plate with 8-degree pitch; radial array of 16 around Y.",
    "size": "span 120, chord 160, thickness 12",
    "position": "array center [0, 120, 0]; first vane at radius 530",
    "material": "aluminium",
    "count": 16
   },
   {
    "name": "FAN_BLADE_FRONT",
    "role": "Primary thrust-producing fan for forward flight.",
    "shape": "Extruded twisted airfoil blade with rounded leading edge; radial array of 18 around Y, 12-degree forward pitch.",
    "size": "root radius 190, tip radius 600, chord 200, thickness 25",
    "position": "array center [0, 260, 0]; first blade root at [190, 260, 0]",
    "material": "carbon fibre",
    "count": 18
   },
   {
    "name": "FAN_HUB",
    "role": "Mounts front fan blades and closes the inlet core opening.",
    "shape": "Lathe profile: tapered cone with cylindrical root flange and smoothed tip.",
    "size": "base dia 420, tip dia 260, length 370",
    "position": "center [0, 335, 0]",
    "material": "titanium",
    "count": 1
   },
   {
    "name": "REAR_FAN_HUB",
    "role": "Carries the counter-rotating fan and provides a forward-facing reverse cone.",
    "shape": "Lathe profile: cylinder with rearward-facing conical nose and front flange.",
    "size": "dia 380, length 260, nose depth 120",
    "position": "center [0, 1180, 0]",
    "material": "titanium",
    "count": 1
   },
   {
    "name": "COUNTER_FAN_BLADE",
    "role": "Reclaims energy and increases thrust; rotates opposite the front fan.",
    "shape": "Extruded twisted airfoil blade with mirrored pitch; radial array of 18 around Y.",
    "size": "root radius 190, tip radius 600, chord 200, thickness 25",
    "position": "array center [0, 1180, 0]; first blade root at [190, 1180, 0]",
    "material": "carbon fibre",
    "count": 18
   },
   {
    "name": "CORE_CASING",
    "role": "Contains compressor and turbine sections and carries the hot core.",
    "shape": "Lathe profile: long cylinder tapering slightly rearward, with three shallow axial ribs.",
    "size": "OD 820, length 1600, wall 22",
    "position": "center [0, 1250, 0]",
    "material": "brushed steel",
    "count": 1
   },
   {
    "name": "NACELLE_SHELL",
    "role": "Outer bypass duct and visual housing for the fan section.",
    "shape": "Revolved profile: faceted octagonal outer silhouette smoothed by hull, open annular bore.",
    "size": "OD 1350, ID 1250, length 1600",
    "position": "center [0, 1100, 0]",
    "material": "painted (gunmetal)",
    "count": 1
   },
   {
    "name": "REVERSE_DUCT",
    "role": "Channels bypass air to the reverse-thrust vanes.",
    "shape": "Cylindrical annular tube with internal cooling ribs; boolean subtracted from core casing clearances.",
    "size": "OD 1200, ID 1100, length 750",
    "position": "center [0, 1775, 0]",
    "material": "dark ceramic",
    "count": 1
   },
   {
    "name": "REVERSE_COWL",
    "role": "Outer sliding shroud that closes the rear bypass duct in forward thrust.",
    "shape": "Cylindrical annular shell with rear chamfer and six axial locking slots.",
    "size": "OD 1350, ID 1200, length 700",
    "position": "center [0, 1900, 0]",
    "material": "titanium",
    "count": 1
   },
   {
    "name": "REVERSE_VANE",
    "role": "Deflects bypass flow forward when reverse thrust is selected.",
    "shape": "Extruded trapezoidal plate with 35-degree deflection angle; radial array of 12 around Y.",
    "size": "radial length 140, chord 220, thickness 18",
    "position": "array center [0, 1850, 0]; first vane at radius 575",
    "material": "dark ceramic",
    "count": 12
   },
   {
    "name": "REVERSE_ACTUATOR_RING",
    "role": "Distributes actuation force to the reverse cowl and vanes.",
    "shape": "Torus-like ring made from revolved rectangular profile with six radial bosses.",
    "size": "OD 1280, ID 1200, radial section 70",
